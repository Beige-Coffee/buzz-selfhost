##### 5. Fill in the random secrets

----- secrets
$ for name in $(grep 'CHANGE_ME_RANDOM' .env | cut -d= -f1); do
$   sed -i.bak "s/^${name}=.*/${name}=$(openssl rand -hex 32)/" .env
$ done && rm -f .env.bak
