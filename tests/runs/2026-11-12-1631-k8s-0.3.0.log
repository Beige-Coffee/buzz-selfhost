===== 1. The values file (kubernetes.md step 3, run as written)
image:
  tag: 0.3.0
  digest: sha256:<hex>
relayUrl: wss://<ip>.sslip.io
ownerPubkey: <hex>
quickstart: true
postgresql:
  enabled: true
redis:
  enabled: true
minio:
  enabled: true
  image: ghcr.io/block/buzz-minio@sha256:<hex>
  mcImage: ghcr.io/block/buzz-minio@sha256:<hex>
relay:
  corsOrigins:
    - tauri://localhost
    - http://tauri.localhost
    - https://<ip>.sslip.io
  extraEnv:
    - {name: BUZZ_PUSH_GATEWAY_DELIVERY_URL, value: "https://push.buzz.xyz/v1/deliveries/apns"}
    - {name: BUZZ_PUSH_ENABLED, value: "true"}
ingress:
  enabled: true
  className: traefik
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt
  tls:
    - hosts: [<ip>.sslip.io]
      secretName: buzz-tls
pairingRelay:
  enabled: true
  url: wss://<ip>.sslip.io/pair
extraManifests:
  - apiVersion: networking.k8s.io/v1
    kind: Ingress
    metadata:
      name: buzz-pairing
    spec:
      ingressClassName: traefik
      tls:
        - hosts: [<ip>.sslip.io]
          secretName: buzz-tls
      rules:
        - host: <ip>.sslip.io
          http:
            paths:
              - path: /pair
                pathType: Prefix
                backend:
                  service:
                    name: buzz-pairing
                    port:
                      number: 5000
