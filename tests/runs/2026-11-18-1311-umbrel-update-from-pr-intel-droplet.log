## the script (update-run.sh)
```bash
#!/usr/bin/env bash
# Nate's path: the live PR's package (5d03829, relay 744f394) installed on umbrelOS 2.0.2 and set up
# through a quick tunnel, then updated to this branch's package, then e2e.sh again on the update.
set -uo pipefail
cd ~/code/buzz-selfhost-main
S=<scratch>
export BUZZ_CLI=$HOME/.local/bin/buzz
K=$S/update-run; mkdir -p "$K"; chmod 700 "$K"
python3 tests/lib/keygen.py > "$K/owner.keys"; chmod 600 "$K/owner.keys"
export DOMAIN_FILE=$K/domain
date
python3 tests/umbrel/server.py up || exit 1
trap 'echo "== Delete the droplet"; python3 tests/umbrel/server.py down; date' EXIT
echo "== Install the live PR's package (5d03829, version 744f394) on umbrelOS 2.0.2"
PKG_ROOT=$S/fork-pr bash tests/umbrel/install.sh 2.0.2 || exit 1
echo "== Set up on the old page, through a quick tunnel"
OWNER_KEYS=$K/owner.keys SETUP_ONLY=1 bash tests/umbrel/e2e.sh
echo "== Update through Umbrel to this branch's package (0.3.0, page 1.1.0)"
PKG_DIR=umbrel/buzz bash tests/umbrel/update.sh
echo "UPDATE EXIT $?"
echo "== e2e.sh on the updated app"
OWNER_KEYS=$K/owner.keys SKIP_SETUP=1 DOMAIN=$(cat "$DOMAIN_FILE") bash tests/umbrel/e2e.sh
echo "E2E EXIT $?"
```
