def tunnel_steps(domain):
    return (
        "<ol>"
        "<li>Install <b>Cloudflare Tunnel</b> from the Umbrel App Store and connect it to your Cloudflare "
        "account. Its page explains how.</li>"
        "<li>In Cloudflare's dashboard, open the tunnel and add a public hostname: <code>" + html.escape(domain) +
        "</code>, with the service type <b>HTTP</b> and the URL <code>" + GATEWAY_URL + "</code>.</li>"
        "<li>Come back here. This page checks the address every few seconds.</li>"
        "</ol>"
    )


def form(setup, error, values):
    owner = values.get("owner", setup["owner"] if setup else "")
    domain = values.get("domain", setup["domain"] if setup else "")
    return (
        '<form method="post" action="save">'
        '<label for="owner">Your public ID</label>'
        '<p class="muted small">Buzz Desktop shows it on its Join screen: choose Add community, then Join a '
        "community. It starts with npub, and makes you the community's owner.</p>"
        '<input type="text" id="owner" name="owner" placeholder="npub1..." autocomplete="off" spellcheck="false" value="' +
        html.escape(owner, quote=True) + '">'
        '<label for="domain">Domain</label>'
        '<p class="muted small">A domain you control, like buzz.example.com. Members connect to it. It is the '
        "community's permanent address: a different domain later starts a new, empty community.</p>"
        '<input type="text" id="domain" name="domain" placeholder="buzz.example.com" autocomplete="off" '
        'spellcheck="false" value="' + html.escape(domain, quote=True) + '">'
        "<button>Save</button></form>"
        + ('<div class="card error">' + html.escape(error) + "</div>" if error else "")
    )


def item(state, text):
    return '<li class="' + state + '"><span class="dot"></span><span>' + text + "</span></li>"


def page(error=None, values=None):
    values = values or {}
    setup = read_setup()
    refresh = ""
    if not setup:
        body = (
            "<p>Run your Buzz community on this Umbrel. Enter two things to start the relay.</p>"
            + form(None, error, values)
            + '<h2>Before members can connect</h2><p class="muted small">Route your domain to this Umbrel with '
            "Cloudflare Tunnel. You can do this before or after saving.</p>"
            + tunnel_steps("your domain")
        )
    else:
        domain = setup["domain"]
        state = checks(domain)
        address = "wss://" + domain
        live = state["relay"] and state["public"]
        if not live:
            refresh = '<meta http-equiv="refresh" content="8">'
        status = "<ul class=\"status\">"
        status += item("ok" if state["relay"] else "wait",
                       "Relay running on this Umbrel" if state["relay"] else "Starting the relay. This takes about a minute the first time.")
        if state["public"]:
            status += item("ok", "Reachable at <code>https://" + html.escape(domain) + "</code>")
        else:
            reason = " (HTTP " + str(state["public_status"]) + ")" if state["public_status"] else ""
            status += item("wait", "Not reachable at <code>https://" + html.escape(domain) + "</code> yet" + reason)
        status += item("ok" if state["pair"] else "wait", "Phones can pair" if state["pair"] else "Phone pairing not reachable yet")
        status += "</ul>"
        body = '<div class="card">' + status + "</div>"
        if not state["public"]:
            body += "<h2>Route your domain here with Cloudflare Tunnel</h2>" + tunnel_steps(domain)
        body += (
            "<h2>Join</h2><p>In Buzz Desktop, choose Add community, then Join a community, and paste this address. "
            "Use the identity whose public ID you entered.</p>"
            '<div class="copy"><input type="text" id="address" readonly value="' + html.escape(address, quote=True) +
            '"><button type="button" onclick="copyAddress(this)">Copy</button></div>'
            "<h2>Members</h2><p>Each member sends you their public ID from Buzz Desktop's Join screen. Add them in "
            "Buzz Desktop under Settings, Invites.</p>"
            "<h2>Phones</h2><p>In Buzz Desktop, open Settings, Mobile, and scan the code with the Buzz app. "
            "Push notifications aren't available for self-hosted communities yet.</p>"
            "<details" + (" open" if error else "") + "><summary>Change settings</summary>"
            '<p class="muted small">Changing the domain starts a new, empty community at the new address.</p>'
            + form(setup, error, values) + "</details>"
        )
    return (
        '<!doctype html><html lang="en"><head><meta charset="utf-8">'
        '<meta name="viewport" content="width=device-width, initial-scale=1">' + refresh +
        "<title>Buzz</title><style>" + STYLE + "</style><script>" + SCRIPT + "</script></head>"
        '<body><main><h1>Buzz</h1><p class="muted">Your community\'s relay, on this Umbrel.</p>' + body +
        "</main></body></html>"
    )


class Handler(http.server.BaseHTTPRequestHandler):
    def send_page(self, text, status=200):
        data = text.encode()
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if urllib.parse.urlsplit(self.path).path in ("/", ""):
            self.send_page(page())
        else:
            self.send_page("Not found", 404)

    def do_POST(self):
        if urllib.parse.urlsplit(self.path).path != "/save":
            return self.send_page("Not found", 404)
        origin = self.headers.get("Origin")
        if origin and urllib.parse.urlsplit(origin).netloc != self.headers.get("Host"):
            return self.send_page("This form only accepts requests from its own page.", 403)
        length = min(int(self.headers.get("Content-Length") or 0), 10000)
        fields = urllib.parse.parse_qs(self.rfile.read(length).decode(errors="replace"))
        values = {name: fields.get(name, [""])[0] for name in ("owner", "domain")}
        try:
            key = owner_hex(values["owner"])
            domain = clean_domain(values["domain"])
        except ValueError as error:
            return self.send_page(page(str(error), values), 400)
        save(values["owner"].strip(), key, domain)
        self.send_response(303)
        self.send_header("Location", "./")
        self.end_headers()

    def log_message(self, format, *args):
        pass


if __name__ == "__main__":
    http.server.ThreadingHTTPServer(("0.0.0.0", 8080), Handler).serve_forever()
