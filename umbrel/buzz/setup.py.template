SCRIPT = """
function copyText(button, text) {
  var done = function () { button.textContent = "Copied"; setTimeout(function () { button.textContent = "Copy"; }, 1500); };
  if (navigator.clipboard && window.isSecureContext) { navigator.clipboard.writeText(text).then(done); return; }
  var area = document.createElement("textarea");
  area.value = text; document.body.appendChild(area); area.select(); document.execCommand("copy"); area.remove(); done();
}
function updateForm(form) {
  var mode = form.querySelector("input[name=mode]:checked");
  var chosen = mode ? mode.value : "";
  form.querySelectorAll("[data-for]").forEach(function (el) {
    el.hidden = el.getAttribute("data-for").split(" ").indexOf(chosen) < 0;
  });
  var save = form.querySelector("button[type=submit]");
  var ack = form.querySelector("input[name=ack]");
  var confirm = form.querySelector("input[name=confirm]");
  var ready = Boolean(chosen) && (!ack || ack.checked);
  if (confirm) { ready = ready && confirm.value.trim().toLowerCase() === confirm.getAttribute("data-expect"); }
  if (save) { save.disabled = !ready; }
}
function reachFromHere(item) {
  var host = item.getAttribute("data-host");
  var text = item.querySelector(".text"), hint = item.querySelector(".hint");
  var controller = new AbortController();
  var timer = setTimeout(function () { controller.abort(); }, 6000);
  fetch("https://" + host + "/_liveness", { mode: "no-cors", cache: "no-store", signal: controller.signal })
    .then(function () {
      item.className = "ok"; text.textContent = "This device reaches Buzz over your tailnet"; hint.textContent = "";
    })
    .catch(function () {
      item.className = "bad"; text.textContent = "This device can't reach Buzz";
      hint.textContent = "Is Tailscale on here, signed in to the same tailnet, and allowed to reach the buzz machine? Devices outside your tailnet can't connect, which is the point of this option.";
    })
    .finally(function () { clearTimeout(timer); });
}
function poll() {
  var list = document.querySelector("[data-poll]");
  if (!list) { return; }
  var phase = list.getAttribute("data-phase");
  fetch("status.json", { cache: "no-store", credentials: "same-origin" }).then(function (r) { return r.json(); }).then(function (data) {
    if (data.phase !== phase) { location.reload(); return; }
    list.innerHTML = data.html;
    list.querySelectorAll("[data-host]").forEach(reachFromHere);
  }).catch(function () {}).finally(function () { setTimeout(poll, 5000); });
}
function howScale(how) {
  how.querySelectorAll(".mb-stage").forEach(function (stage) {
    if (stage.clientWidth) { stage.style.setProperty("--s", Math.min(1, stage.clientWidth / 560)); }
  });
}
function howShow(how, n) {
  how.querySelectorAll(".how-tabs button").forEach(function (b, i) { b.setAttribute("aria-selected", String(i === n)); });
  how.querySelectorAll(".how-step").forEach(function (s, i) { s.hidden = i !== n; });
  howScale(how);
}
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll("details.how").forEach(function (how) {
    how.classList.add("js");
    how.querySelectorAll(".how-tabs button").forEach(function (b, i) { b.addEventListener("click", function () { howShow(how, i); }); });
    how.addEventListener("toggle", function () { howScale(how); });
    howShow(how, 0);
  });
  window.addEventListener("resize", function () { document.querySelectorAll("details.how[open]").forEach(howScale); });
  document.querySelectorAll("form[data-guided]").forEach(function (form) {
    form.addEventListener("input", function () { updateForm(form); });
    form.addEventListener("change", function () { updateForm(form); });
    updateForm(form);
  });
  document.querySelectorAll("[data-host]").forEach(reachFromHere);
  setTimeout(poll, 5000);
});
"""


def esc(text):
    return html.escape(str(text), quote=True)


def layout(body, signed_in=True, title="Buzz Relay"):
    logout = ('<form method="post" action="logout"><button class="link" type="submit">Sign out</button></form>'
              if signed_in else "")
    return (
        '<!doctype html><html lang="en"><head><meta charset="utf-8">'
        '<meta name="viewport" content="width=device-width, initial-scale=1"><title>' + esc(title) + "</title>"
        "<style>" + STYLE + HOW_STYLE + "</style><script>" + SCRIPT + "</script></head><body>"
        '<header class="hd"><span class="brand">' + BEE + "<span>Buzz Relay</span></span>" + logout + "</header>"
        "<main>" + body + '<p class="foot">Buzz is open source, from Block: '
        '<a href="https://github.com/block/buzz" target="_blank" rel="noopener">github.com/block/buzz</a>.</p>'
        "</main></body></html>"
    )


def error_box(error):
    return '<div class="error" role="alert">' + esc(error) + "</div>" if error else ""


def login_page(error=""):
    return layout(
        '<p class="eyebrow">Sign in</p><h1>Set up your <mark>Buzz</mark> community</h1>'
        '<p class="lede">Enter this app\'s password to continue.</p>'
        '<form method="post" action="login"><label class="field" for="password">Password</label>'
        '<input type="password" id="password" name="password" autocomplete="current-password" autofocus>'
        '<button class="btn" type="submit">Sign in</button></form>' + error_box(error) +
        '<div class="panel" style="margin-top:28px"><p><b>Where to find it.</b> Umbrel shows this app\'s password '
        "when you open Buzz Relay from the home screen, under Default credentials. Later, right-click Buzz Relay on "
        "the home screen and choose Settings, then Default credentials (on umbrelOS 1.7: right-click Buzz Relay, "
        "then Show default credentials).</p><p class=\"muted\">Why a second password? Umbrel's sign-in protects "
        "this page in your browser, but every app on an Umbrel shares one network, so other apps could reach it "
        "directly. This password keeps them out. It stays signed in on this browser for 30 days.</p></div>",
        signed_in=False)


def choice(mode, kicker, badge, title, text, needs, checked):
    return (
        '<label class="choice"><input type="radio" name="mode" value="' + mode + '"' + (" checked" if checked else "") + ">"
        '<span class="kicker"><span>' + kicker + (" &middot; " + badge if badge else "") + '</span><span class="pick"></span></span>'
        "<h3>" + title + "</h3><p>" + text + '</p><p class="needs"><b>Needs</b>' + needs + "</p></label>"
    )


def address_fields(values, setup):
    mode = values.get("mode") or (setup or {}).get("mode") or ""
    domain = values.get("domain", (setup or {}).get("domain", "") if (setup or {}).get("mode") == "domain" else "")
    return (
        '<div class="choices">'
        + choice("domain", "Lasting", "recommended", "Your own domain",
                 "A name you own, like <code>buzz.yourteam.com</code>. Cloudflare Tunnel connects it to this Umbrel, "
                 "so members reach it from anywhere, with no router changes.",
                 "a domain (around 10 US dollars a year) whose DNS is on a free Cloudflare account, and "
                 "Umbrel's Cloudflare Tunnel app.", mode == "domain")
        + choice("funnel", "Quickest", "", "A free Tailscale address",
                 "Tailscale gives this Umbrel a public name like <code>buzz.tail1234.ts.net</code>. Members reach it "
                 "from anywhere and don't need Tailscale.",
                 "a free Tailscale account for you, the owner.", mode == "funnel")
        + choice("private", "Private network", "", "Only devices on your Tailscale network",
                 "Nothing is reachable from the internet. Members' devices connect through Tailscale.",
                 "Tailscale on every member's device, and their access to your Tailscale network.", mode == "private")
        + "</div>"
        '<div data-for="domain"><label class="field" for="domain">The domain<span class="tag">for keeps</span></label>'
        '<input type="text" id="domain" name="domain" placeholder="buzz.yourteam.com" autocomplete="off" '
        'spellcheck="false" value="' + esc(domain) + '">'
        '<div class="panel"><p>Saving the name here doesn\'t set up DNS or the tunnel. The next screen walks you '
        "through both in Cloudflare, and checks the result.</p><ul>"
        "<li>Cloudflare serves HTTPS for you, so it can read the traffic it carries. Uploads are limited to 100 MB.</li>"
        "<li>A tunnel opens no router ports and hides your home address, but Buzz is still reachable from the "
        "internet. Only members can read or post; keep Umbrel updated.</li></ul></div></div>"
        '<div data-for="funnel"><div class="panel"><p>Tailscale names the address after you sign in, on the next '
        "screen. It stays the same while you keep this Tailscale account and don't rename the machine.</p><ul>"
        "<li>Traffic passes through Tailscale encrypted; HTTPS ends on this Umbrel.</li>"
        "<li>The address belongs to your Tailscale account. If you later want your own domain, that's a new "
        "address, so a new, empty community.</li></ul></div></div>"
        '<div data-for="private"><div class="panel"><p>Tailscale names the address after you sign in, with a trusted '
        "HTTPS certificate, so Buzz and phones accept it. Every member needs:</p><ul>"
        "<li>the Tailscale app on each device they use, phones included;</li>"
        "<li>access to your Tailscale network: invite them to it, or share the <b>buzz</b> machine with them;</li>"
        "<li>Buzz membership, which you give in Buzz as usual.</li></ul></div></div>"
    )


def continuity_note():
    return (
        '<div class="warn"><p><b>Choose the address for keeps.</b> Buzz knows a community by its address. If you '
        "later switch to an address this community hasn't used, Buzz starts a separate, empty community there: "
        "messages, files and members don't come with it. The old ones stay stored, and come back if you switch "
        'back. Buzz can\'t move a community to a new address yet (<a href="' + ISSUE + '" target="_blank" '
        'rel="noopener">block/buzz#4952</a>).</p><p class="muted small">Moving to another server is different: with '
        "the same address and Buzz's data restored, the community comes along intact.</p></div>"
    )


