"""Buzz on Umbrel: the setup and status page.

Takes the owner's public ID and the community's address, writes the relay's settings, and checks
that the relay runs here and answers at its public address. The address is either the owner's own
domain, routed here by Cloudflare Tunnel, or a free Tailscale address from this app's own Tailscale
machine. Umbrel renders this file from a template, so it must not contain a dollar sign.
"""
import concurrent.futures
import html
import http.client
import http.server
import json
import os
import re
import ssl
import threading
import time
import urllib.parse

SETTINGS_DIR = "/settings"
RELAY_ENV = os.path.join(SETTINGS_DIR, "relay.env")
SETUP_JSON = os.path.join(SETTINGS_DIR, "setup.json")
TAILSCALE_ON = os.path.join(SETTINGS_DIR, "tailscale-enabled")
TAILSCALE_STATUS = os.path.join(SETTINGS_DIR, "tailscale-status.json")
GATEWAY_URL = "buzz-gateway:80"
ISSUE = "https://github.com/block/buzz/issues/4952"

BECH32 = "qpzry9x8gf2tvdw0s3jn54khce6mua7l"


def bech32_polymod(values):
    generator = [0x3B6A57B2, 0x26508E6D, 0x1EA119FA, 0x3D4233DD, 0x2A1462B3]
    check = 1
    for value in values:
        top = check >> 25
        check = ((check & 0x1FFFFFF) << 5) ^ value
        for i in range(5):
            if (top >> i) & 1:
                check ^= generator[i]
    return check


def owner_hex(text):
    """The owner's 64-character hex key, from an npub (checksum verified) or hex."""
    value = text.strip().lower()
    if value.startswith("nostr:"):
        value = value[6:]
    if re.fullmatch(r"[0-9a-f]{64}", value):
        return value
    if value.startswith("nsec"):
        raise ValueError("That is a private key. Never paste it anywhere. Use your public ID, which starts with npub.")
    if not value.startswith("npub1") or len(value) != 63:
        raise ValueError("Paste your public ID from Buzz: Settings, Identity, Nostr address. It starts with npub1 and is 63 characters long.")
    data = []
    for char in value[5:]:
        if char not in BECH32:
            raise ValueError("That public ID has a character a public ID can't contain. Copy it again from Buzz.")
        data.append(BECH32.index(char))
    expanded = [ord(c) >> 5 for c in "npub"] + [0] + [ord(c) & 31 for c in "npub"]
    if bech32_polymod(expanded + data) != 1:
        raise ValueError("That public ID doesn't check out: a character is wrong or missing. Copy it again from Buzz.")
    acc = bits = 0
    key = bytearray()
    for value5 in data[:-6]:
        acc = (acc << 5) | value5
        bits += 5
        while bits >= 8:
            bits -= 8
            key.append((acc >> bits) & 0xFF)
    if len(key) != 32:
        raise ValueError("That public ID is the wrong length. Copy it again from Buzz.")
    return key.hex()


def clean_domain(text):
    domain = re.sub(r"^[a-z]+://", "", text.strip().lower()).split("/")[0].rstrip(".")
    label = r"[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?"
    if len(domain) > 253 or not re.fullmatch(r"(" + label + r"\.)+[a-z][a-z0-9-]{0,61}[a-z0-9]", domain):
        raise ValueError("Enter a domain name, like buzz.example.com.")
    if domain.endswith((".local", ".localhost", ".internal", ".lan", ".home.arpa", ".ts.net")):
        raise ValueError("Use a public domain you control, routed here by Cloudflare Tunnel. "
                         "For a Tailscale address, choose the free Tailscale address instead.")
    return domain


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write_atomic(path, text):
    temporary = path + ".tmp"
    with open(temporary, "w") as f:
        f.write(text)
    os.replace(temporary, path)


def relay_domain():
    """The address the relay runs at, once its settings are written."""
    try:
        with open(RELAY_ENV) as f:
            for line in f:
                if line.startswith("BUZZ_DOMAIN="):
                    return line.strip().split("=", 1)[1]
    except OSError:
        pass
    return None


def write_relay_env(key, domain):
    # The relay watches this file and restarts when it changes.
    write_atomic(RELAY_ENV, "\n".join([
        "RELAY_OWNER_PUBKEY=" + key,
        "BUZZ_DOMAIN=" + domain,
        "RELAY_URL=wss://" + domain,
        "BUZZ_MEDIA_BASE_URL=https://" + domain + "/media",
        "BUZZ_MEDIA_SERVER_DOMAIN=" + domain,
        "BUZZ_CORS_ORIGINS=https://" + domain + ",tauri://localhost,http://tauri.localhost",
        "BUZZ_PAIRING_RELAY_URL=wss://" + domain + "/pair",
    ]) + "\n")


def save(owner_text, key, mode, domain):
    write_atomic(SETUP_JSON, json.dumps({"owner": owner_text, "owner_hex": key, "mode": mode, "domain": domain}))
    if mode == "tailscale":
        # This app's Tailscale machine starts; the watcher writes the relay's settings once the
        # machine has its address.
        write_atomic(TAILSCALE_ON, "on\n")
        if domain:
            write_relay_env(key, domain)
        elif os.path.exists(RELAY_ENV):
            os.remove(RELAY_ENV)
    else:
        if os.path.exists(TAILSCALE_ON):
            os.remove(TAILSCALE_ON)
        write_relay_env(key, domain)


def tailscale_state():
    """(backend state, machine address, login link, machine ID) from this app's Tailscale machine."""
    status = read_json(TAILSCALE_STATUS) or {}
    me = status.get("Self") or {}
    return (status.get("BackendState") or "", (me.get("DNSName") or "").rstrip("."),
            status.get("AuthURL") or "", me.get("ID") or "")


def tailscale_watcher():
    """Once the Tailscale machine is signed in, its address becomes the community's. Only once:
    a later change of the machine's name would start a new community, so it never moves on its own."""
    while True:
        try:
            setup = read_json(SETUP_JSON)
            if setup and setup.get("mode") == "tailscale" and not setup.get("domain"):
                state, name, _, _ = tailscale_state()
                if state == "Running" and name.endswith(".ts.net"):
                    save(setup["owner"], setup["owner_hex"], "tailscale", name)
        except (OSError, KeyError, ValueError):
            pass
        time.sleep(3)


def request(host, port, path, tls=False, headers=None, timeout=5):
    """(status, body) or (None, reason). A WebSocket upgrade comes back 101 with no body."""
    try:
        if tls:
            conn = http.client.HTTPSConnection(host, port, timeout=timeout, context=ssl.create_default_context())
        else:
            conn = http.client.HTTPConnection(host, port, timeout=timeout)
        conn.request("GET", path, headers=headers or {})
        response = conn.getresponse()
        body = b"" if response.status == 101 else response.read(4096)
        conn.close()
        return response.status, body
    except (OSError, http.client.HTTPException) as error:
        return None, str(error).encode()


UPGRADE = {"Connection": "Upgrade", "Upgrade": "websocket", "Sec-WebSocket-Version": "13",
           "Sec-WebSocket-Key": "dGhlIHNhbXBsZSBub25jZQ=="}


def checks(domain):
    jobs = {
        "relay": lambda: request("buzz_relay_1", 8080, "/_readiness"),
        "public": lambda: request(domain, 443, "/_liveness", tls=True),
        "pair": lambda: request(domain, 443, "/pair", tls=True, headers=UPGRADE),
    }
    with concurrent.futures.ThreadPoolExecutor(len(jobs)) as pool:
        futures = {name: pool.submit(job) for name, job in jobs.items()}
        results = {name: future.result() for name, future in futures.items()}
    return {
        "relay": results["relay"][0] == 200,
        "public": results["public"][0] == 200 and results["public"][1].strip() == b"ok",
        "public_status": results["public"][0],
        "pair": results["pair"][0] == 101,
    }


