def tunnel_steps(domain):
    return (
        "<ol>"
        "<li>Install <b>Cloudflare Tunnel</b> from the Umbrel App Store and connect it to your Cloudflare "
        "account. Its page explains how.</li>"
        "<li>In Cloudflare's dashboard, open the tunnel and add a public hostname: <code>" + html.escape(domain) +
        "</code>, with the service type <b>HTTP</b> and the URL <code>" + GATEWAY_URL + "</code>.</li>"
        "<li>Come back here. This page checks the address every few seconds.</li>"
        "</ol>"
    )


def form(setup, error, values):
    setup = setup or {}
    owner = values.get("owner", setup.get("owner", ""))
    mode = values.get("mode", setup.get("mode", "domain"))
    domain = values.get("domain", setup.get("domain", "") if setup.get("mode") == "domain" else "")
    checked = ' checked' if values.get("ack") == "yes" or (not values and setup.get("mode") == "tailscale") else ""
    return (
        '<form method="post" action="save">'
        '<label for="owner">Your public ID</label>'
        '<p class="muted small">In Buzz, open Settings, Identity, and copy the Nostr address (npub). In Buzz '
        "0.X, it's on the Join a community screen. It makes you the community's owner.</p>"
        '<input type="text" id="owner" name="owner" placeholder="npub1..." autocomplete="off" spellcheck="false" value="' +
        html.escape(owner, quote=True) + '">'
        "<fieldset><legend>Address</legend>"
        '<p class="muted small">Members connect to this address. It is the community\'s permanent identity: '
        "Buzz can't change a community's address yet (<a href=\"" + ISSUE + '" target="_blank" rel="noopener">'
        "block/buzz#4952</a>).</p>"
        '<div class="choice"><label><input type="radio" name="mode" value="domain" id="mode-domain"' +
        (" checked" if mode != "tailscale" else "") + "> Your own domain (recommended)</label>"
        '<p class="muted small">Yours for good: you can move the community to another server later and keep '
        "it. Routed here by Cloudflare Tunnel.</p>"
        '<input type="text" id="domain" name="domain" placeholder="buzz.example.com" autocomplete="off" '
        'spellcheck="false" value="' + html.escape(domain, quote=True) + '"></div>'
        '<div class="choice"><label><input type="radio" name="mode" value="tailscale" id="mode-tailscale"' +
        (" checked" if mode == "tailscale" else "") + "> Free Tailscale address (to try it out)</label>"
        '<p class="muted small">A public address like <code>buzz.tail1234.ts.net</code>, from a free Tailscale '
        "account you sign in to next. Members don't need Tailscale. The address belongs to that Tailscale "
        "account.</p>"
        '<label class="check"><input type="checkbox" name="ack" value="yes" id="ack"' + checked + ">"
        "I understand that moving to my own domain later starts a new, empty community. Messages and files "
        "won't come with it.</label></div></fieldset>"
        '<button id="save">Save</button></form>'
        + ('<div class="card error">' + html.escape(error) + "</div>" if error else "")
    )


def item(state, text):
    return '<li class="' + state + '"><span class="dot"></span><span>' + text + "</span></li>"


def tailscale_steps():
    """The Tailscale sign-in and Funnel steps, or None once the machine has its address."""
    state, name, auth_url, node = tailscale_state()
    if state == "NeedsLogin" and auth_url:
        return ("<h2>Sign in to Tailscale</h2><p>Sign in, or make a free account, to give this Umbrel its "
                'Buzz address.</p><a class="button" href="' + html.escape(auth_url, quote=True) +
                '" target="_blank" rel="noopener">Sign in to Tailscale</a>')
    if state == "NeedsMachineAuth":
        return ('<h2>Approve this machine</h2><p>Your Tailscale network requires approving new machines. Approve '
                '<b>buzz</b> in <a href="https://login.tailscale.com/admin/machines" target="_blank" '
                'rel="noopener">Tailscale\'s admin console</a>.</p>')
    if state != "Running" or not name:
        return "<h2>Starting Tailscale</h2><p>This takes a few seconds.</p>"
    return None


def funnel_steps(node):
    # Tailscale's own link from the Funnel command, if it printed one, else the same consent page
    # built from the machine's ID.
    link = ""
    try:
        with open(os.path.join(SETTINGS_DIR, "tailscale-funnel.log")) as f:
            found = re.search(r"https://login\.tailscale\.com/\S+", f.read())
            link = found.group(0) if found else ""
    except OSError:
        pass
    if not link:
        link = "https://login.tailscale.com/f/funnel?node=" + urllib.parse.quote(node) if node else \
            "https://login.tailscale.com/admin/machines"
    return ("<h2>Turn on public access</h2><p>Tailscale Funnel makes the address reachable for members "
            "without Tailscale. Turn it on for this machine, and if Tailscale asks, turn on HTTPS "
            'certificates too.</p><a class="button" href="' + html.escape(link, quote=True) +
            '" target="_blank" rel="noopener">Turn on Funnel</a>'
            '<p class="muted small">This page checks the address every few seconds.</p>')


def page(error=None, values=None):
    values = values or {}
    setup = read_json(SETUP_JSON)
    refresh = ""
    if not setup:
        return wrap("<p>Run your Buzz community on this Umbrel. Choose its address and its owner to start "
                    "the relay.</p>" + form(None, error, values), refresh)
    mode = setup.get("mode", "domain")
    if mode == "tailscale":
        steps = tailscale_steps()
        if not steps and not relay_domain():
            steps = "<h2>Getting the address</h2><p>This takes a few seconds.</p>"
        if steps:
            body = steps + "<details><summary>Change settings</summary>" + form(setup, error, values) + "</details>"
            return wrap(body, '<meta http-equiv="refresh" content="5">')
    domain = relay_domain() or setup.get("domain") or ""
    state = checks(domain)
    address = "https://" + domain
    if not (state["relay"] and state["public"]):
        refresh = '<meta http-equiv="refresh" content="8">'
    status = '<ul class="status">'
    status += item("ok" if state["relay"] else "wait",
                   "Relay running on this Umbrel" if state["relay"] else "Starting the relay. This takes about a minute the first time.")
    if state["public"]:
        status += item("ok", "Reachable at <code>https://" + html.escape(domain) + "</code>")
    else:
        reason = " (HTTP " + str(state["public_status"]) + ")" if state["public_status"] else ""
        status += item("wait", "Not reachable at <code>https://" + html.escape(domain) + "</code> yet" + reason)
    status += item("ok" if state["pair"] else "wait", "Phones can pair" if state["pair"] else "Phone pairing not reachable yet")
    status += "</ul>"
    body = '<div class="card">' + status + "</div>"
    if not state["public"]:
        if mode == "tailscale":
            body += funnel_steps(tailscale_state()[3])
        else:
            body += "<h2>Route your domain here with Cloudflare Tunnel</h2>" + tunnel_steps(domain)
    if mode == "tailscale":
        body += ('<p class="muted small">A free Tailscale address. Moving to your own domain later starts a new, '
                 "empty community; Buzz can't change a community's address yet (<a href=\"" + ISSUE +
                 '" target="_blank" rel="noopener">block/buzz#4952</a>). In <a href="https://login.tailscale.com/'
                 'admin/machines" target="_blank" rel="noopener">Tailscale\'s admin console</a>, turn off key '
                 "expiry for this machine, or the address goes offline after 180 days.</p>")
    body += (
        "<h2>Join</h2><p>In Buzz, choose Join a community and paste this address, with the identity whose "
        "public ID you entered. Buzz 0.X takes it as <code>wss://" + html.escape(domain) + "</code>.</p>"
        '<div class="copy"><input type="text" id="address" readonly value="' + html.escape(address, quote=True) +
        '"><button type="button" onclick="copyAddress(this)">Copy</button></div>'
        "<h2>Members</h2><p>In Buzz, open Settings, Community admin, Membership, Invite members: send a link, "
        "or add someone directly by their public ID. In Buzz 0.X, it's Settings, Invites.</p>"
        "<h2>Phones</h2><p>In Buzz, open Settings, Pair mobile, and scan the code with the Buzz app on the "
        "phone (Buzz 0.X: Settings, Mobile). Push notifications aren't available for self-hosted "
        "communities yet.</p>"
        "<details" + (" open" if error else "") + "><summary>Change settings</summary>"
        '<p class="muted small">A different address starts a new, empty community at that address.</p>'
        + form(setup, error, values) + "</details>"
    )
    return wrap(body, refresh)


def wrap(body, refresh):
    return (
        '<!doctype html><html lang="en"><head><meta charset="utf-8">'
        '<meta name="viewport" content="width=device-width, initial-scale=1">' + refresh +
        "<title>Buzz</title><style>" + STYLE + "</style><script>" + SCRIPT + "</script></head>"
        '<body><main><h1>Buzz</h1><p class="muted">Your community\'s relay, on this Umbrel.</p>' + body +
        "</main></body></html>"
    )


class Handler(http.server.BaseHTTPRequestHandler):
    def send_page(self, text, status=200):
        data = text.encode()
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if urllib.parse.urlsplit(self.path).path in ("/", ""):
            self.send_page(page())
        else:
            self.send_page("Not found", 404)

    def do_POST(self):
        if urllib.parse.urlsplit(self.path).path != "/save":
            return self.send_page("Not found", 404)
        origin = self.headers.get("Origin")
        if origin and urllib.parse.urlsplit(origin).netloc != self.headers.get("Host"):
            return self.send_page("This form only accepts requests from its own page.", 403)
        length = min(int(self.headers.get("Content-Length") or 0), 10000)
        fields = urllib.parse.parse_qs(self.rfile.read(length).decode(errors="replace"))
        values = {name: fields.get(name, [""])[0] for name in ("owner", "mode", "domain", "ack")}
        values["mode"] = "tailscale" if values["mode"] == "tailscale" else "domain"
        try:
            key = owner_hex(values["owner"])
            if values["mode"] == "tailscale":
                if values["ack"] != "yes":
                    raise ValueError("Tick the box to confirm you understand a Tailscale address can't be "
                                     "changed to your own domain later without starting over.")
                setup = read_json(SETUP_JSON) or {}
                # Keep the machine's address if it already has one: it's still the same community.
                domain = setup.get("domain", "") if setup.get("mode") == "tailscale" else ""
            else:
                domain = clean_domain(values["domain"])
        except ValueError as error:
            return self.send_page(page(str(error), values), 400)
        save(values["owner"].strip(), key, values["mode"], domain)
        self.send_response(303)
        self.send_header("Location", "./")
        self.end_headers()

    def log_message(self, format, *args):
        pass


if __name__ == "__main__":
    threading.Thread(target=tailscale_watcher, daemon=True).start()
    http.server.ThreadingHTTPServer(("0.0.0.0", 8080), Handler).serve_forever()
