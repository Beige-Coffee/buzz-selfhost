def status_html(items):
    out = []
    for entry in items:
        host = ""
        if entry["key"] == "device":
            host = ' data-host="' + esc(relay_domain()) + '"'
        out.append('<li class="' + entry["state"] + '"' + host + '><span class="icon"></span><span class="text">'
                   + entry["text"] + '</span><span class="hint">' + entry["hint"] + "</span></li>")
    return "".join(out)


def phase_of(setup, live):
    return setup["mode"] + ":" + ("live" if live else "connecting") + ":" + (relay_domain() or "-")


def copy_button(text):
    return ('<button class="copy-mini" type="button" onclick="copyText(this, \'' + esc(text) + '\')">Copy</button>')


def connect_steps(setup, domain):
    mode = setup["mode"]
    if mode == "domain":
        return (
            '<section class="part"><h2>Connect the name in Cloudflare</h2>'
            "<p class=\"muted\">The domain is the name; the tunnel connects it to this Umbrel. Do these once:</p>"
            '<ol class="do"><li><b>Put the domain on Cloudflare.</b> Buy one anywhere (or from Cloudflare) and add it '
            "to a free Cloudflare account, so Cloudflare runs its DNS.</li>"
            "<li><b>Install Cloudflare Tunnel</b> from the Umbrel App Store. Create a tunnel in Cloudflare's dashboard "
            "and paste its token into the app. "
            '<a href="' + TUNNEL_GUIDE + '" target="_blank" rel="noopener">The app\'s guide</a> shows each screen.</li>'
            "<li><b>Add a public hostname</b> to the tunnel, with these values:"
            '<dl class="values"><dt>Hostname</dt><dd><code>' + esc(domain) + "</code>" + copy_button(domain) + "</dd>"
            "<dt>Service type</dt><dd><code>HTTP</code></dd>"
            "<dt>URL</dt><dd><code>" + GATEWAY_URL + "</code>" + copy_button(GATEWAY_URL) + "</dd></dl>"
            '<p class="muted small">Route only this name to Buzz. The setup page, Umbrel and your other apps stay '
            "off the internet.</p></li></ol>"
            '<p class="muted small">This page checks every few seconds. A new name can take a few minutes to work.</p></section>'
        )
    state = tailscale_state()
    if state["backend"] in ("", "NoState", "Starting") or (state["backend"] == "NeedsLogin" and not state["auth_url"]):
        action = "<p class=\"muted\">Starting Tailscale. This takes a few seconds.</p>"
    elif state["backend"] == "NeedsLogin":
        action = ("<p>Sign in, or make a free account. The link waits as long as you need.</p>"
                  '<a class="btn" href="' + esc(state["auth_url"]) + '" target="_blank" rel="noopener">Sign in to Tailscale</a>')
    elif state["backend"] == "NeedsMachineAuth":
        action = ('<p>Your Tailscale network requires approving new machines. Approve <b>buzz</b> in '
                  '<a href="' + TAILSCALE_ADMIN + '" target="_blank" rel="noopener">Tailscale\'s admin console</a>.</p>')
    else:
        link = consent_link()
        wanted = published() == mode
        action = ("" if wanted else
                  ("<p>Tailscale asks you once to allow " + ("Funnel and " if mode == "funnel" else "") +
                   "HTTPS certificates for this machine.</p>" +
                   ('<a class="btn" href="' + esc(link) + '" target="_blank" rel="noopener">Allow it in Tailscale</a>' if link else
                    '<p class="muted small">Waiting for Tailscale to ask.</p>')))
    title = "Connect through Tailscale" if mode == "funnel" else "Connect your private network"
    return '<section class="part"><h2>' + title + "</h2>" + action + "</section>" if action else ""


def private_members_note():
    return (
        '<div class="panel"><p><b>Each member needs three things.</b></p><ul>'
        "<li>The Tailscale app on every device, signed in.</li>"
        "<li>Access to your Tailscale network: invite them, or share the <b>buzz</b> machine with them in "
        '<a href="' + TAILSCALE_ADMIN + '" target="_blank" rel="noopener">the admin console</a>. If your access rules '
        'aren\'t the default, <a href="' + TAILSCALE_ACCESS + '" target="_blank" rel="noopener">allow them</a> to reach '
        "the buzz machine on port 443.</li>"
        "<li>Buzz membership, from you in Buzz.</li></ul>"
        "<p class=\"muted small\">A device without the first two can't connect at all; one without the third "
        "connects but can't read or post.</p></div>"
    )


def notifications_note(setup):
    if not push_on(setup):
        return ('<p class="muted small">Phone notifications are off: the phone shows new messages while the Buzz app is '
                "open. Settings, below, turns them on.</p>")
    return ('<p class="muted small">Phone notifications are on, for direct messages and mentions, on iPhone. '
            "This Umbrel wakes the phone through Block's push service, which passes Apple a "
            'fixed "reconnect" signal, never a message; the phone then fetches the message from here'
            + (", over Tailscale" if setup["mode"] == "private" else "") +
            ". Android has no notifications yet. Settings, below, says what Block's service sees, and turns them "
            "off.</p>")


def settings_part(setup, error, values):
    current = relay_domain() or setup.get("domain") or ""
    owner = values.get("owner", "") if values.get("form") == "owner" else ""
    address_values = values if values.get("form") == "address" else {}
    return (
        '<section class="part"><h2>Settings</h2>'
        "<details" + (" open" if values.get("form") == "owner" else "") + "><summary>Change the owner</summary><div class=\"inner\">"
        '<form method="post" action="owner"><p class="muted small">The current owner becomes an admin, which you can '
        "remove in Buzz. The address and community stay the same.</p>"
        '<label class="field" for="new-owner">New owner\'s public ID (npub)</label>'
        '<input type="text" id="new-owner" name="owner" autocomplete="off" spellcheck="false" placeholder="npub1..." value="' + esc(owner) + '">'
        '<button class="btn small ghost" type="submit">Change the owner</button></form>'
        + (error_box(error) if values.get("form") == "owner" else "") + "</div></details>"
        "<details><summary>Phone notifications</summary><div class=\"inner\">"
        '<form method="post" action="notifications"><p class="muted small">When they\'re on, this Umbrel wakes '
        "members' iPhones for direct messages and mentions, through Block's push "
        'service. It passes Apple a fixed "reconnect" signal, never a message, and sees when a phone is woken and '
        "this Umbrel's internet address. Saving restarts Buzz for a few seconds.</p>"
        '<label class="check"><input type="checkbox" name="push" value="on"' + (" checked" if push_on(setup) else "")
        + "><span>Send phone notifications</span></label>"
        '<button class="btn small ghost" type="submit">Save</button></form></div></details>'
        "<details" + (" open" if values.get("form") == "address" else "") + "><summary>Change the address</summary><div class=\"inner\">"
        + continuity_note() +
        '<form method="post" action="address" data-guided><input type="hidden" name="owner" value="' + esc(setup["owner"]) + '">'
        + address_fields(address_values, setup)
        + ('<label class="field" for="confirm">To confirm, type the current address: <code>' + esc(current) + "</code></label>"
